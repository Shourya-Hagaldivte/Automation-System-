# Gmail/SMTP for automatic order-tracking emails after approval.
# For Gmail, use an App Password, not your normal Gmail password.
EMAIL_USER=yourgmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=Agentic Procurement Platform <yourgmail@gmail.com>

# The backend also supports these aliases if your existing .env already uses them.
# GMAIL_USER=yourgmail@gmail.com
# GMAIL_APP_PASSWORD=your_gmail_app_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourgmail@gmail.com
# SMTP_PASSWORD=your_gmail_app_password
# SMTP_FROM=Agentic Procurement Platform <yourgmail@gmail.com>

# Optional market price feed overrides.
# RFP_PRICE_FEED_URL=https://your-price-feed.example.com/items.json
# RFP_PRICE_FEED_FILE=/absolute/path/to/price-feed.json
